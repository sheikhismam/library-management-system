# ============================================================================
# FRONTEND BUILD-TIME ENV - copy to frontend/.env.production before building.
#
# IMPORTANT: VITE_* variables are inlined into the bundle at BUILD time, so the
# frontend MUST be built with these values set on the deploy host.
#
# VITE_API_URL = the base ORIGIN (no trailing slash, no /api) that Django is
# reachable at. All requests go to {VITE_API_URL}/api/v1/...
#
# For a single-URL deployment the frontend and API share one origin, so set this
# to the public site URL, e.g. https://mylibrary.example.com (nginx reverse-proxies
# /api, /media and /static to Django).
#
# For a split deployment (SPA on a static host, API elsewhere) set it to the API
# origin, e.g. https://mylibrary-api.example.com
#
# If left unset the build currently falls back to http://127.0.0.1:8000 which is
# for LOCAL DEVELOPMENT ONLY and will NOT work on a public host. Always set it.
# ============================================================================
VITE_API_URL=https://mylibrary.example.com
