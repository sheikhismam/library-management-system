# ============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE - copy to backend/.env (or provider env vars)
# NEVER commit a real .env. Generate a real SECRET_KEY and passwords.
# ============================================================================

# --- Django core ---
# SECURITY: DEBUG must be False in production.
DEBUG=False
# Generate a long random value:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME_to_a_long_random_string
# Comma-separated public hostnames, e.g. mylibrary.example.com,www.mylibrary.example.com
DJANGO_ALLOWED_HOSTS=mylibrary.example.com
# Comma-separated https origins for CSRF (Django admin / session auth)
DJANGO_CSRF_TRUSTED_ORIGINS=https://mylibrary.example.com

# --- Database (MySQL) ---
DB_NAME=library_db
DB_USER=library_user
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_HOST=mysql
DB_PORT=3306

# --- CORS (comma-separated explicit origins; leave empty to allow all) ---
# Set to the public origin(s) the SPA is served on, e.g. https://mylibrary.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://mylibrary.example.com
