# ---------------------------------------------------------------------------
# Database Configuration (MySQL) - required
# ---------------------------------------------------------------------------
DB_NAME=library_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------------------------------------------------------------------------
# Django Secret Key & Debug (development defaults)
# ---------------------------------------------------------------------------
# Generate a long random value for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-f_4wlg6ysb&xilo%3+$ogqnte55cl5byx=+efogobny%=v%a+u
DEBUG=True

# ---------------------------------------------------------------------------
# Hosts / CSRF (development defaults)
# ---------------------------------------------------------------------------
# Comma-separated hostnames. '*' allows any host (safe for local demo only).
DJANGO_ALLOWED_HOSTS=*
# Comma-separated https origins for CSRF (Django admin / session auth), e.g.
# https://mylibrary.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# CORS (default: allow all)
# ---------------------------------------------------------------------------
# Comma-separated explicit origins override allow-all, e.g.
# https://mylibrary.example.com
DJANGO_CORS_ALLOWED_ORIGINS=
